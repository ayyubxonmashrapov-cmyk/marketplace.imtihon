// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  fullName       String?  @map("full_name")
  phone          String   @unique
  hashedPassword String   @map("hashed_password")
  imageUrl       String?  @map("image_url")
  createAt       DateTime @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt       DateTime @updatedAt @map("update_at") @db.Timestamptz(6)

  master           Master[]
  admin            Admin[]
  customer         Customer[]
  platformUserRole PlatformUserRole[]

  @@map("users")
}

model Admin {
  id       String    @id @default(uuid()) @db.Uuid
  role     AdminRole @default(ADMIN)
  userId   String    @map("user_id") @db.Uuid
  createAt DateTime  @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt DateTime  @updatedAt @map("update_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("admins")
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model Master {
  id     String @id @default(uuid()) @db.Uuid
  region Region

  userId         String         @map("user_id") @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order          Order[]
  raiting        Rating[]
  specCategories SpecCategory[]
  createAt       DateTime       @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt       DateTime       @updatedAt @map("update_at") @db.Timestamptz(6)

  @@map("masters")
}

enum Region {
  Toshkent_shahri
  Andijon_viloyati
  Buxoro_viloyati
  Jizzax_viloyati
  Qashqadaryo_viloyati
  Navoiy_viloyati
  Namangan_viloyati
  Samarqand_viloyati
  Sirdaryo_viloyati
  Surxondaryo_viloyati
  Toshkent_viloyati
  Fargona_viloyati
  Xorazm_viloyati
  Qoraqalpogiston_Respublikasi
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  specCategories SpecCategory[]
}

model SpecCategory {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  experience Int
  masterId   String   @map("master_id") @db.Uuid
  createAt   DateTime @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt   DateTime @updatedAt @map("update_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  master   Master   @relation(fields: [masterId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("categories")
}

model OrderCategory {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  createAt   DateTime @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt   DateTime @updatedAt @map("update_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("order_category")
}

model Customer {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  address  String?
  createAt DateTime @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt DateTime @updatedAt @map("updata_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order   Order[]
  raiting Rating[]

  @@map("customers")
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  problem           String
  orderStatus       orderStatus       @map("order_status")
  orderMatserStatus orderMatserStatus @map("order_master_status")
  region            Region
  detailedAddress   String            @map("detail_address")
  masterId          String?           @map("master_id") @db.Uuid
  customerId        String            @map("customer_id") @db.Uuid
  createAt          DateTime          @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt          DateTime          @updatedAt @map("update_at") @db.Timestamptz(6)

  master        Master?         @relation(fields: [masterId], references: [id])
  cusotmer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  payment       Payment?
  orderCategory OrderCategory[]

  @@map("orders")
}

enum orderStatus {
  BOSH
  JARAYONDA
  BAJARILDI
  BEKOR_QILINDI
  NIZOLI_HOLAT
}

enum orderMatserStatus {
  USTALAR_TAKLIF_BERMOQDA
  USTA_TANLANDI
  USTA_QABUL_QILDI
}

model Payment {
  id       String        @id @default(uuid()) @db.Uuid
  orderId  String        @unique @map("order_id") @db.Uuid
  status   paymentStatus
  type     paymentType
  createAt DateTime      @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt DateTime      @updatedAt @map("update_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("payments")
}

enum paymentStatus {
  PAID
  NOT_PAID
}

enum paymentType {
  CARD
  CASH
}

model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  stars      Int      @db.SmallInt
  comment    String
  masterId   String   @map("master_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  createAt   DateTime @default(now()) @map("create_at") @db.Timestamptz(6)
  updateAt   DateTime @updatedAt @map("update_at") @db.Timestamptz(6)

  master   Master   @relation(fields: [masterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("rating")
}

model PlatformUserRole {
  userId    String   @map("user_id") @db.Uuid
  roleCode  String   @map("role_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updateAt  DateTime @updatedAt @map("update_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, roleCode])
  @@map("platform_user_roles")
}
