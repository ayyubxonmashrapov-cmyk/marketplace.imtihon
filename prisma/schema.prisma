// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int     @id @default(autoincrement())
  fullName       String?
  phone          String  @unique
  hashedPassword String
  imageUrl       String?

  master   Master[]
  admin    Admin[]
  customer Customer[]
}

model Admin {
  id     Int       @id @default(autoincrement())
  role   AdminRole @default(ADMIN)
  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model Master {
  id         Int    @id @default(autoincrement())
  region     Region

  userId         Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order          Order[]
  raiting        Raiting[]
  specCategories SpecCategory[]
}

enum Region {
  Toshkent_shahri
  Andijon_viloyati
  Buxoro_viloyati
  Jizzax_viloyati
  Qashqadaryo_viloyati
  Navoiy_viloyati
  Namangan_viloyati
  Samarqand_viloyati
  Sirdaryo_viloyati
  Surxondaryo_viloyati
  Toshkent_viloyati
  Fargona_viloyati
  Xorazm_viloyati
  Qoraqalpogiston_Respublikasi
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
}

model SpecCategory {
  id         Int @id @default(autoincrement())
  categoryId Int
  experience Int
  masterId   Int

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model OrderCategory {
  id         Int @id @default(autoincrement())
  categoryId Int
  orderId    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Customer {
  id      Int     @id @default(autoincrement())
  userId  Int
  address String?

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order   Order[]
  raiting Raiting[]
}

model Order {
  id                Int               @id @default(autoincrement())
  problem           String
  orderStatus       orderStatus
  orderMatserStatus orderMatserStatus
  region            Region
  detailedAddress   String
  masterId          Int?
  customerId        Int

  master        Master?         @relation(fields: [masterId], references: [id])
  cusotmer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  payment       Payment?
  orderCategory OrderCategory[]
}

enum orderStatus {
  BOSH
  JARAYONDA
  BAJARILDI
  BEKOR_QILINDI
  NIZOLI_HOLAT
}

enum orderMatserStatus {
  USTALAR_TAKLIF_BERMOQDA
  USTA_TANLANDI
  USTA_QABUL_QILDI
}

model Payment {
  id      Int           @id @default(autoincrement())
  orderId Int           @unique
  status  paymentStatus
  type    paymentType

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum paymentStatus {
  PAID
  NOT_PAID
}

enum paymentType {
  CARD
  CASH
}

model Raiting {
  id         Int    @id @default(autoincrement())
  stars      Int    @db.SmallInt
  comment    String
  masterId   Int
  customerId Int

  master   Master   @relation(fields: [masterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
